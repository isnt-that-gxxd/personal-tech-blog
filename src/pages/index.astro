---
import { Image } from 'astro:assets';
import DocumentationLayout from '../layouts/DocumentationLayout.astro';
import {
	formatPostDate,
	getFeaturedPosts,
	getPublishedPosts,
	sortPostsByDate,
} from '../lib/posts';
import { withBase } from '../lib/urls';

const publishedPosts = await getPublishedPosts();
const latestPosts = sortPostsByDate(publishedPosts).slice(0, 3);
const featuredPosts = getFeaturedPosts(publishedPosts);
---

<DocumentationLayout
	title="통 속의 뇌 | 배우고, 만들고, 기록합니다."
	description="AI, 바이브 코딩, 프로젝트 개발과 프로덕트 디자인에 대한 기록."
>
	<main id="main-content" class="home-page">
		<section class="hero" aria-labelledby="home-title">
			<h1 id="home-title">배우고, 만들고, 기록합니다.</h1>
			<p class="hero-description">
				AI, 바이브 코딩, 프로젝트 개발과 프로덕트 디자인에 대한 기록.
			</p>
		</section>

		<section class="latest-section" aria-labelledby="latest-title">
			<header class="section-heading">
				<h2 id="latest-title">최신 게시글</h2>
				<a class="view-all" href={withBase('/posts')}>전체 보기 <span aria-hidden="true">→</span></a>
			</header>

			{
				latestPosts.length > 0 ? (
					<div class="latest-list">
						{latestPosts.map((post) => {
							const date = post.data.date.toISOString().slice(0, 10);
							return (
								<article>
									<a class="post-card" href={withBase(`/posts/${post.id}`)}>
										<div class="post-meta">
											<span>{post.data.category}</span>
											<span aria-hidden="true">·</span>
											<time datetime={date}>{formatPostDate(post.data.date)}</time>
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</a>
								</article>
							);
						})}
					</div>
				) : (
					<p class="empty-state">아직 게시된 글이 없습니다.</p>
				)
			}
		</section>

		{
			featuredPosts.length >= 3 && (
				<section class="featured-section" aria-labelledby="featured-title">
					<header class="section-heading">
						<h2 id="featured-title">추천 게시글</h2>
					</header>
					<div class="featured-grid">
						{featuredPosts.map((post) => {
							const date = post.data.date.toISOString().slice(0, 10);
							return (
								<article>
									<a class="featured-card" href={withBase(`/posts/${post.id}`)}>
										{post.data.thumbnail && (
											<div class="thumbnail-frame">
												<Image
													src={post.data.thumbnail}
													alt={post.data.thumbnailAlt ?? post.data.title}
													class="post-thumbnail"
												/>
											</div>
										)}
										<div class="featured-card-content">
											<div class="post-meta">
												<span>{post.data.category}</span>
												<span aria-hidden="true">·</span>
												<time datetime={date}>{formatPostDate(post.data.date)}</time>
											</div>
											<h3>{post.data.title}</h3>
											<p>{post.data.description}</p>
										</div>
									</a>
								</article>
							);
						})}
					</div>
				</section>
			)
		}
	</main>
</DocumentationLayout>

<style>
	.home-page {
		width: var(--home-content-width);
		margin: 0 auto;
		padding: 64px 0 96px;
	}

	.hero {
		padding: 0 0 3.1rem;
		border-bottom: 1px solid var(--color-border);
	}

	h1 {
		margin: 0;
		color: var(--color-primary-text);
		font-size: clamp(2.35rem, 5vw, 3.25rem);
		font-weight: 650;
		letter-spacing: -0.06em;
		line-height: 1.22;
		word-break: keep-all;
	}

	.hero-description {
		margin: 1rem 0 0;
		color: var(--color-secondary-text);
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.latest-section,
	.featured-section {
		margin-top: 2.8rem;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.9rem;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--color-primary-text);
		font-size: 1.65rem;
		font-weight: 650;
		letter-spacing: -0.035em;
		line-height: 1.3;
	}

	.view-all {
		display: inline-flex;
		min-height: 44px;
		flex: none;
		align-items: center;
		gap: 0.3rem;
		color: var(--color-secondary-text);
		font-size: 0.82rem;
		text-decoration: none;
	}

	.view-all:visited {
		color: var(--color-secondary-text);
	}

	.view-all:hover,
	.view-all:visited:hover {
		color: var(--color-accent-hover);
	}

	.view-all:focus-visible,
	.post-card:focus-visible,
	.featured-card:focus-visible {
		border-radius: 0.35rem;
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.latest-list article {
		border-bottom: 1px solid var(--color-border);
	}

	.post-card {
		display: block;
		padding: 1.35rem 0 1.45rem;
		color: var(--color-primary-text);
		text-decoration: none;
	}

	.post-card:visited {
		color: var(--color-primary-text);
	}

	.thumbnail-frame {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 0.6rem 0.6rem 0 0;
	}

	.post-thumbnail {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-secondary-text);
		font-size: 0.78rem;
	}

	.post-meta span:first-child {
		color: var(--color-secondary-text);
		font-weight: 600;
	}

	h3 {
		margin: 0.5rem 0 0.35rem;
		color: var(--color-primary-text);
		font-size: 1.16rem;
		font-weight: 620;
		letter-spacing: -0.03em;
		line-height: 1.5;
		overflow-wrap: anywhere;
		word-break: keep-all;
	}

	.post-card:visited h3,
	.featured-card:visited h3 {
		color: var(--color-primary-text);
	}

	.post-card:hover h3,
	.featured-card:hover h3 {
		color: var(--color-accent-hover);
	}

	.post-card p,
	.featured-card p {
		margin: 0;
		color: var(--color-secondary-text);
		font-size: 0.92rem;
		line-height: 1.7;
		overflow-wrap: anywhere;
	}

	.empty-state {
		margin: 0;
		padding: 1.5rem 0;
		color: var(--color-secondary-text);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.featured-grid article {
		display: flex;
		min-width: 0;
	}

	.featured-card {
		display: flex;
		width: 100%;
		flex-direction: column;
		border: 1px solid var(--color-border);
		border-radius: 0.65rem;
		background: transparent;
		color: var(--color-primary-text);
		text-decoration: none;
	}

	.featured-card:visited {
		color: var(--color-primary-text);
	}

	.featured-card-content {
		padding: 1.05rem 1.1rem 1.2rem;
	}

	@media (max-width: 600px) {
		.home-page {
			padding-top: 36px;
			padding-bottom: 72px;
		}

		.hero {
			padding-bottom: 1.7rem;
		}

		h1 {
			font-size: clamp(1.85rem, 7.5vw, 2.25rem);
			letter-spacing: -0.05em;
			line-height: 1.25;
		}

		.hero-description {
			margin-top: 0.8rem;
			font-size: 0.98rem;
			line-height: 1.65;
		}

		.latest-section {
			margin-top: 1.7rem;
		}

		.featured-section {
			margin-top: 1.9rem;
		}

		.section-heading {
			margin-bottom: 0.55rem;
		}

		.section-heading h2 {
			font-size: 1.35rem;
			line-height: 1.4;
		}

		.view-all {
			font-size: 0.8rem;
		}

		.post-card {
			padding: 1rem 0 1.1rem;
		}

		.post-card h3 {
			margin-top: 0.4rem;
			font-size: 1.08rem;
			line-height: 1.45;
		}

		.post-card p,
		.featured-card p {
			font-size: 0.9rem;
			line-height: 1.6;
		}

		.featured-grid {
			grid-template-columns: 1fr;
			gap: 0.65rem;
		}

		.featured-card-content {
			padding: 0.95rem 1rem 1.05rem;
		}
	}

	@media (max-width: 320px) {
		:global(body) {
			min-width: 0;
		}
	}
</style>
