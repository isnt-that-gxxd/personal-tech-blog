---
import DocumentationLayout from '../layouts/DocumentationLayout.astro';
import { formatPostDate, getPublishedPosts, sortPostsByDate } from '../lib/posts';

const publishedPosts = await getPublishedPosts();
const latestPosts = sortPostsByDate(publishedPosts).slice(0, 5);
const categories = ['Learn AI', 'Vibe Coding', 'Projects', 'Product Design'] as const;
const categoryCounts = categories.map((category) => ({
	category,
	count: publishedPosts.filter((post) => post.data.category === category).length,
}));
---

<DocumentationLayout
	title="개발 노트 | 배우고, 만들고, 기록합니다."
	description="AI, 바이브 코딩, 프로젝트 개발과 프로덕트 디자인에 대한 기록."
>
	<main id="main-content" class="home-page">
		<section class="hero" aria-labelledby="home-title">
			<p class="eyebrow">개발 노트</p>
			<h1 id="home-title">배우고, 만들고, 기록합니다.</h1>
			<p class="hero-description">
				AI, 바이브 코딩, 프로젝트 개발과 프로덕트 디자인에 대한 기록.
			</p>
		</section>

		<section class="latest-section" aria-labelledby="latest-title">
			<header class="section-heading">
				<h2 id="latest-title">최신 게시글</h2>
				<a class="view-all" href="/posts">전체 보기 <span aria-hidden="true">→</span></a>
			</header>

			<div class="latest-list">
				{
					latestPosts.length > 0 ? (
						latestPosts.map((post) => {
							const date = post.data.date.toISOString().slice(0, 10);
							return (
								<article>
									<a class="post-card" href={`/posts/${post.id}`}>
										<div class="post-meta">
											<span>{post.data.category}</span>
											<span aria-hidden="true">·</span>
											<time datetime={date}>{formatPostDate(post.data.date)}</time>
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</a>
								</article>
							);
						})
					) : (
						<p class="empty-state">아직 게시된 글이 없습니다.</p>
					)
				}
			</div>
		</section>

		<section class="categories-section" aria-labelledby="categories-title">
			<header class="section-heading">
				<h2 id="categories-title">카테고리</h2>
			</header>
			<ul class="category-grid">
				{
					categoryCounts.map(({ category, count }) => (
						<li>
							<div class="category-card">
								<h3>{category}</h3>
								<p>{count}개 게시글</p>
							</div>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</DocumentationLayout>

<style>
	.home-page {
		width: min(100% - 48px, 920px);
		margin: 0 auto;
		padding: 64px 0 96px;
	}

	.hero {
		padding: 0 0 3.1rem;
		border-bottom: 1px solid #e8eaed;
	}

	.eyebrow {
		margin: 0 0 0.9rem;
		color: #68717d;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	h1 {
		margin: 0;
		color: #1d2229;
		font-size: clamp(2.35rem, 5vw, 3.25rem);
		font-weight: 650;
		letter-spacing: -0.06em;
		line-height: 1.22;
	}

	.hero-description {
		margin: 1rem 0 0;
		color: #606975;
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.latest-section,
	.categories-section {
		margin-top: 2.8rem;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}

	h2 {
		margin: 0;
		color: #20252c;
		font-size: 1.35rem;
		font-weight: 620;
		letter-spacing: -0.035em;
		line-height: 1.45;
	}

	.view-all {
		flex: none;
		color: #626c78;
		font-size: 0.82rem;
		text-decoration: none;
	}

	.view-all:hover {
		color: #20242b;
	}

	.view-all:focus-visible,
	.post-card:focus-visible {
		border-radius: 0.35rem;
		outline: 2px solid #667d98;
		outline-offset: 4px;
	}

	.latest-list article {
		border-bottom: 1px solid #e9ebee;
	}

	.post-card {
		display: block;
		padding: 1.35rem 0 1.45rem;
		color: inherit;
		text-decoration: none;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: #7a828d;
		font-size: 0.78rem;
	}

	.post-meta span:first-child {
		color: #59636f;
		font-weight: 600;
	}

	h3 {
		margin: 0.5rem 0 0.35rem;
		color: #242a32;
		font-size: 1.16rem;
		font-weight: 620;
		letter-spacing: -0.03em;
		line-height: 1.5;
		transition: color 140ms ease;
	}

	.post-card:hover h3 {
		color: #526579;
	}

	.post-card p,
	.category-card p {
		margin: 0;
		color: #646d78;
		font-size: 0.92rem;
		line-height: 1.7;
	}

	.empty-state {
		margin: 0;
		padding: 1.5rem 0;
		color: #68717c;
	}

	.categories-section {
		padding-top: 0.2rem;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.category-card {
		min-height: 96px;
		padding: 1rem 1.05rem;
		border: 1px solid #e7e9ec;
		border-radius: 0.55rem;
		background: #fff;
	}

	.category-card h3 {
		margin: 0 0 0.35rem;
		font-size: 0.94rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.category-card p {
		color: #7a828d;
		font-size: 0.78rem;
	}

	@media (max-width: 600px) {
		.home-page {
			width: calc(100% - 36px);
			padding-top: 44px;
		}

		.hero {
			padding-bottom: 2.4rem;
		}

		.hero-description {
			font-size: 1rem;
		}

		.latest-section,
		.categories-section {
			margin-top: 2.25rem;
		}

		.category-grid {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}

		.category-card {
			min-height: 0;
			padding: 0.85rem 0.95rem;
		}
	}
</style>
