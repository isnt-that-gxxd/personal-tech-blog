---
import { getPublishedPosts, sortPostsByDate } from '../../lib/posts';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = sortPostsByDate(await getPublishedPosts());
---

<DocumentationLayout
	title="모든 게시글 | 통 속의 뇌"
	description="통 속의 뇌의 기술 게시글을 최신순으로 확인하세요."
>
	<main id="main-content" class="posts-page">
		<header class="posts-header">
			<p class="eyebrow">통 속의 뇌</p>
			<h1>모든 게시글</h1>
			<p class="posts-description">기술과 제품을 만들며 배운 내용을 기록합니다.</p>
		</header>
		<PostList posts={posts} />
	</main>
</DocumentationLayout>

<style>
	.posts-page {
		width: min(100% - 48px, 820px);
		margin: 0 auto;
		padding: 58px 0 100px;
	}

	.posts-header {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--color-secondary-text);
		font-size: 0.82rem;
		font-weight: 600;
	}

	h1 {
		margin: 0;
		color: var(--color-primary-text);
		font-size: clamp(2rem, 5vw, 2.5rem);
		font-weight: 650;
		letter-spacing: -0.055em;
		line-height: 1.25;
	}

	.posts-description {
		margin: 0.9rem 0 0;
		color: var(--color-secondary-text);
		font-size: 1rem;
		line-height: 1.7;
	}

	@media (max-width: 520px) {
		.posts-page {
			width: calc(100% - 36px);
			padding-top: 40px;
		}
	}
</style>
