---
import { getPublishedPosts, formatPostDate, sortPostsByDate } from '../../lib/posts';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';

const posts = sortPostsByDate(await getPublishedPosts());
---

<DocumentationLayout
	title="모든 게시글 | 개발 노트"
	description="개발 노트의 기술 게시글을 최신순으로 확인하세요."
>
	<main id="main-content" class="posts-page">
		<header class="posts-header">
			<p class="eyebrow">개발 노트</p>
			<h1>모든 게시글</h1>
			<p class="posts-description">기술과 제품을 만들며 배운 내용을 기록합니다.</p>
		</header>

		<section class="post-list" aria-label="게시글 목록">
			{
				posts.length > 0 ? (
					posts.map((post) => {
						const date = post.data.date.toISOString().slice(0, 10);
						return (
							<article>
								<a class="post-card" href={`/posts/${post.id}`}>
									<div class="post-meta">
										<span>{post.data.category}</span>
										<span aria-hidden="true">·</span>
										<time datetime={date}>{formatPostDate(post.data.date)}</time>
									</div>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</a>
							</article>
						);
					})
				) : (
					<p class="empty-state">아직 게시된 글이 없습니다.</p>
				)
			}
		</section>
	</main>
</DocumentationLayout>

<style>
	.posts-page {
		width: min(100% - 48px, 820px);
		margin: 0 auto;
		padding: 58px 0 100px;
	}

	.posts-header {
		padding-bottom: 2rem;
		border-bottom: 1px solid #e8eaed;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: #68717d;
		font-size: 0.82rem;
		font-weight: 600;
	}

	h1 {
		margin: 0;
		color: #1d2229;
		font-size: clamp(2rem, 5vw, 2.5rem);
		font-weight: 650;
		letter-spacing: -0.055em;
		line-height: 1.25;
	}

	.posts-description {
		margin: 0.9rem 0 0;
		color: #68717c;
		font-size: 1rem;
		line-height: 1.7;
	}

	.post-list article {
		border-bottom: 1px solid #e9ebee;
	}

	.post-card {
		display: block;
		padding: 1.55rem 0 1.7rem;
		color: inherit;
		text-decoration: none;
	}

	.post-card:hover h2 {
		color: #526579;
	}

	.post-card:focus-visible {
		border-radius: 0.35rem;
		outline: 2px solid #667d98;
		outline-offset: 4px;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: #7a828d;
		font-size: 0.78rem;
	}

	.post-meta span:first-child {
		color: #59636f;
		font-weight: 600;
	}

	h2 {
		margin: 0.55rem 0 0.4rem;
		color: #242a32;
		font-size: 1.3rem;
		font-weight: 620;
		letter-spacing: -0.035em;
		line-height: 1.45;
		transition: color 140ms ease;
	}

	.post-card p {
		margin: 0;
		color: #646d78;
		font-size: 0.94rem;
		line-height: 1.7;
	}

	.empty-state {
		padding: 2rem 0;
		color: #68717c;
	}

	@media (max-width: 520px) {
		.posts-page {
			width: calc(100% - 36px);
			padding-top: 40px;
		}

		.post-card {
			padding: 1.3rem 0 1.45rem;
		}

		h2 {
			font-size: 1.18rem;
		}
	}
</style>
