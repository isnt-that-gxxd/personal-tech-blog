---
interface PostLink {
	href: string;
	title: string;
}

interface Props {
	previous?: PostLink;
	next?: PostLink;
}

const { previous, next } = Astro.props;
---

<nav class="post-floating-nav" aria-label="게시글 이동">
	{
		previous ? (
			<a href={previous.href} title={`이전 글: ${previous.title}`}>
				<span aria-hidden="true">← </span>이전 글
			</a>
		) : (
			<span class="disabled" aria-disabled="true">
				<span aria-hidden="true">← </span>이전 글
			</span>
		)
	}
	<a class="list-link" href="/posts" aria-label="게시글 목록">
		<span aria-hidden="true">▦ </span>목록
	</a>
	{
		next ? (
			<a href={next.href} title={`다음 글: ${next.title}`}>
				다음 글<span aria-hidden="true"> →</span>
			</a>
		) : (
			<span class="disabled" aria-disabled="true">
				다음 글<span aria-hidden="true"> →</span>
			</span>
		)
	}
</nav>

<style>
	.post-floating-nav {
		position: fixed;
		z-index: 15;
		bottom: calc(16px + env(safe-area-inset-bottom, 0px));
		left: 50%;
		display: flex;
		width: max-content;
		max-width: calc(100vw - 24px);
		align-items: stretch;
		padding: 5px;
		transform: translateX(-50%);
		border: 1px solid #e4e7eb;
		border-radius: 999px;
		background: rgb(255 255 255 / 92%);
		box-shadow: 0 8px 26px rgb(25 32 42 / 12%);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.post-floating-nav a,
	.post-floating-nav .disabled {
		display: inline-flex;
		min-width: 48px;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1rem;
		color: #4a535f;
		font-size: 0.82rem;
		font-weight: 550;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
	}

	.post-floating-nav a + a,
	.post-floating-nav a + .disabled,
	.post-floating-nav .disabled + a,
	.post-floating-nav .disabled + .disabled {
		border-left: 1px solid #e7e9ed;
	}

	.post-floating-nav a:hover {
		color: #20242b;
	}

	.post-floating-nav a:focus-visible {
		z-index: 1;
		border-radius: 999px;
		outline: 2px solid #667d98;
		outline-offset: 1px;
	}

	.post-floating-nav .disabled {
		color: #a4aab2;
	}

	@media (max-width: 480px) {
		.post-floating-nav {
			width: calc(100vw - 24px);
			justify-content: space-between;
		}

		.post-floating-nav a,
		.post-floating-nav .disabled {
			flex: 1 1 0;
			padding-inline: 0.4rem;
			font-size: 0.76rem;
		}
	}

	@media (max-width: 350px) {
		.post-floating-nav a,
		.post-floating-nav .disabled {
			padding-inline: 0.25rem;
			font-size: 0.7rem;
		}
	}
</style>
