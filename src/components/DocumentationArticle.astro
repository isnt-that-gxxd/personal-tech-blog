---
import { Code } from 'astro:components';
import PostFloatingNavigation from './PostFloatingNavigation.astro';
import DocumentationLayout from '../layouts/DocumentationLayout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface PostLink {
	href: string;
	title: string;
}

interface Props {
	title?: string;
	description?: string;
	category?: string;
	dateLabel?: string;
	dateIso?: string;
	headings?: Heading[];
	previous?: PostLink;
	next?: PostLink;
}

const {
	title,
	description,
	category,
	dateLabel,
	dateIso,
	headings = [],
	previous,
	next,
} = Astro.props;
const isPost = title !== undefined;

const requestExample = `type User = {
  id: string;
  name: string;
  email: string;
};

type ApiError = {
  code: string;
  message: string;
};

async function getUser(userId: string, signal?: AbortSignal): Promise<User> {
  const response = await fetch(\`/api/users/\${encodeURIComponent(userId)}\`, {
    headers: { Accept: 'application/json' },
    signal,
  });

  if (!response.ok) {
    const error: ApiError = await response.json();
    throw new Error(\`[\${error.code}] \${error.message}\`);
  }

  const payload: unknown = await response.json();
  if (!isUser(payload)) {
    throw new TypeError('사용자 응답 형식이 올바르지 않습니다.');
  }

  return payload;
}

function isUser(value: unknown): value is User {
  if (typeof value !== 'object' || value === null) return false;
  return (
    'id' in value &&
    typeof value.id === 'string' &&
    'name' in value &&
    typeof value.name === 'string' &&
    'email' in value &&
    typeof value.email === 'string'
  );
}

const controller = new AbortController();
const timeout = setTimeout(() => controller.abort(), 5_000);

try {
  const user = await getUser('user_42', controller.signal);
  console.log(user.name);
} finally {
  clearTimeout(timeout);
}`;

const retryExample = `async function withRetry<T>(
  loadDocument: (options: { signal: AbortSignal }) => Promise<T>,
  signal: AbortSignal,
): Promise<T> {
  const delays = [250, 750, 1_500];

  for (let attempt = 0; attempt <= delays.length; attempt += 1) {
    try {
      return await loadDocument({ signal });
    } catch (error) {
      if (!isRetryable(error) || attempt === delays.length) {
        throw error;
      }

      await wait(delays[attempt], signal);
    }
  }

  throw new Error('재시도 한도를 초과했습니다.');
}`;
---

<DocumentationLayout
	title={isPost ? `${title} | 개발 노트` : '안전한 비동기 작업 설계 | 개발 노트'}
	description={
		isPost
			? description ?? ''
			: '실패를 예측하고 복구할 수 있는 비동기 API 설계 방법을 살펴봅니다.'
	}
>
	<div class:list={['reading-layout', { 'has-post-navigation': isPost }]}>
		<aside class="topic-sidebar" aria-label="문서 주제 탐색">
			<details class="topic-menu">
				<summary>{isPost ? '카테고리' : '주제 탐색'} <span aria-hidden="true">⌄</span></summary>
				{
					isPost ? (
						<nav class="topic-links" aria-label="카테고리">
							<p class="nav-caption">카테고리</p>
							<span class:list={{ selected: category === 'Learn AI' }} aria-current={category === 'Learn AI' ? 'true' : undefined}>Learn AI</span>
							<span class:list={{ selected: category === 'Vibe Coding' }} aria-current={category === 'Vibe Coding' ? 'true' : undefined}>Vibe Coding</span>
							<span class:list={{ selected: category === 'Projects' }} aria-current={category === 'Projects' ? 'true' : undefined}>Projects</span>
							<span class:list={{ selected: category === 'Product Design' }} aria-current={category === 'Product Design' ? 'true' : undefined}>Product Design</span>
						</nav>
					) : (
						<nav class="topic-links" aria-label="문서 주제">
							<p class="nav-caption">개발 가이드</p>
							<a href="#overview">시작하기</a>
							<a href="#execution-model">실행 모델</a>
							<a class="selected" href="#async-boundaries" aria-current="location">비동기 처리</a>
							<a href="#testing">테스트 전략</a>
							<a href="#operations">운영 가이드</a>
							<p class="nav-caption second-caption">참고 자료</p>
							<a href="#checklist">설계 체크리스트</a>
						</nav>
					)
				}
			</details>
		</aside>

		<main id="main-content" class="article-column">
			<nav class="breadcrumbs" aria-label="현재 위치">
				<a href="/">개발 노트</a>
				<span aria-hidden="true">/</span>
				<a href={isPost ? '#article-category' : '#overview'}>
					{isPost ? category : '웹 개발'}
				</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{isPost ? title : '비동기 처리'}</span>
			</nav>

			<article>
				{
					isPost ? (
						<header class="article-header post-header">
							<p class="eyebrow" id="article-category">
								{category} <span aria-hidden="true">·</span> 기술 가이드
							</p>
							<div class="article-meta">
								<time datetime={dateIso}>{dateLabel}</time>
							</div>
						</header>
					) : (
						<header class="article-header">
					<p class="eyebrow">웹 개발 <span aria-hidden="true">·</span> 설계 가이드</p>
					<h1>실패를 견디는 비동기 작업 설계</h1>
					<p class="dek">
						네트워크 요청은 언제든 지연되거나 실패할 수 있습니다. 오류를 숨기지 않고,
						사용자와 시스템이 다음 행동을 선택할 수 있도록 경계를 설계하는 방법을 정리합니다.
					</p>
					<div class="article-meta">
						<span class="author-avatar" aria-hidden="true">김</span>
						<span>김민서</span>
						<span class="meta-dot" aria-hidden="true">·</span>
						<time datetime="2026-11-12">2026년 11월 12일</time>
						<span class="meta-dot" aria-hidden="true">·</span>
						<span>읽는 시간 8분</span>
					</div>
				</header>
					)
				}

				<div class="article-body">
					{isPost ? <slot /> : (
						<>
					<section aria-labelledby="overview">
						<h2 id="overview">이 글에서 다루는 내용</h2>
						<p>
							비동기 코드를 안정적으로 만드는 핵심은 모든 실패를 막는 데 있지 않습니다.
							실패가 발생했을 때 <strong>어디에서, 어떤 이유로</strong> 일어났는지 알 수 있고,
							안전한 복구가 가능한 경계를 만드는 데 있습니다. 이 글에서는 요청의 생명주기,
							오류 표현, 재시도 기준을 하나의 흐름으로 살펴봅니다.
						</p>
						<ul>
							<li>지연 시간과 실패를 함수의 계약에 포함하기</li>
							<li>응답 데이터를 신뢰하기 전에 검증하기</li>
							<li>재시도와 취소를 명시적인 정책으로 다루기</li>
						</ul>
					</section>

					<section aria-labelledby="execution-model">
						<h2 id="execution-model">실행 모델 이해하기</h2>
						<p>
							<strong><code>async</code> 함수도 호출한 순서대로 끝난다는 뜻은 아닙니다.</strong>
							함수는 첫 번째 <code>await</code>에서 제어를 넘기고, 호출자는 그동안 다른 일을
							계속합니다. 따라서 반환 타입뿐 아니라 완료 시점과 취소 방법도 호출 계약의
							일부로 문서화해야 합니다.
						</p>
						<blockquote>
							<p>
								비동기 경계는 지연을 감추는 추상화가 아니라, 지연과 실패를 다루기 위한
								명시적인 약속입니다.
							</p>
						</blockquote>
						<h3 id="event-loop">이벤트 루프와 완료 순서</h3>
						<p>
							현재 실행 중인 동기 작업이 끝나면 대기 중인 마이크로태스크가 처리되고,
							그 다음 렌더링과 다음 작업이 이어집니다. 여러 요청을 동시에 시작했다면
							완료 순서가 시작 순서와 다를 수 있으므로, 결과를 합칠 때는 식별자를 기준으로
							정렬하거나 필요한 경우 순차 실행을 선택하세요.
						</p>
					</section>

					<section aria-labelledby="async-boundaries">
						<h2 id="async-boundaries">안전한 비동기 경계 만들기</h2>
						<p>
							요청 함수가 네트워크 응답을 곧바로 애플리케이션 데이터로 취급하면 오류가
							여러 화면으로 번집니다. 아래 예시는 HTTP 상태를 먼저 확인하고, 외부에서
							들어온 값을 <code>unknown</code>으로 다룬 다음 타입 가드로 검증합니다.
							요청에는 <code>AbortSignal</code>을 전달해 더 이상 필요하지 않은 작업도
							정리할 수 있게 합니다.
						</p>

						<div class="code-card">
							<div class="code-toolbar">
								<span class="language-label">TypeScript</span>
								<button class="copy-button" type="button" data-copy={requestExample}>
									<svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
										<rect x="5.25" y="2.25" width="8.5" height="10.5" rx="1.5"></rect>
										<path d="M10.75 12.75v1A1.25 1.25 0 0 1 9.5 15h-6A1.25 1.25 0 0 1 2.25 13.75v-8A1.25 1.25 0 0 1 3.5 4.5h1.75"></path>
									</svg>
									<span>복사</span>
								</button>
							</div>
							<div class="code-surface">
								<Code code={requestExample} lang="ts" theme="github-light" />
							</div>
							<p class="sr-only copy-status" role="status" aria-live="polite"></p>
						</div>

						<h3 id="validate-response">응답은 신뢰 경계에서 검증하기</h3>
						<p>
							TypeScript의 타입은 컴파일 시점의 약속입니다. 서버에서 받은 JSON에는
							런타임 검증이 필요하므로 응답을 <code>unknown</code>으로 받고 필요한 필드의
							형식과 존재 여부를 확인합니다. 검증 실패는 빈 객체 같은 기본값으로 바꾸지
							말고, 호출자가 구분할 수 있는 오류로 반환하세요.
						</p>

						<h3 id="retry-policy">재시도에는 끝과 조건이 있어야 합니다</h3>
						<p>
							일시적인 네트워크 문제는 재시도로 해결될 수 있지만, 잘못된 입력이나 권한
							오류를 반복해도 결과는 달라지지 않습니다. 재시도는 횟수와 간격을 제한하고,
							멱등성이 보장되는 작업에만 적용해야 합니다.
						</p>
						<div class="code-card compact-code">
							<div class="code-toolbar">
								<span class="language-label">TypeScript</span>
								<button class="copy-button" type="button" data-copy={retryExample}>
									<svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
										<rect x="5.25" y="2.25" width="8.5" height="10.5" rx="1.5"></rect>
										<path d="M10.75 12.75v1A1.25 1.25 0 0 1 9.5 15h-6A1.25 1.25 0 0 1 2.25 13.75v-8A1.25 1.25 0 0 1 3.5 4.5h1.75"></path>
									</svg>
									<span>복사</span>
								</button>
							</div>
							<div class="code-surface">
								<Code code={retryExample} lang="ts" theme="github-light" />
							</div>
							<p class="sr-only copy-status" role="status" aria-live="polite"></p>
						</div>
					</section>

					<section aria-labelledby="testing">
						<h2 id="testing">실패 경로를 테스트하기</h2>
						<p>
							성공 응답만 확인하면 가장 중요한 계약을 놓치기 쉽습니다. 테스트에서는
							결과값뿐 아니라 요청 횟수, 취소 신호, 오류 종류처럼 호출자가 의존하는
							동작을 검증합니다.
						</p>
						<div class="table-wrap">
							<table>
								<caption>비동기 요청에서 확인할 테스트 사례</caption>
								<thead>
									<tr>
										<th scope="col">상황</th>
										<th scope="col">기대 동작</th>
										<th scope="col">검증 포인트</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>정상 응답</td>
										<td>검증된 데이터 반환</td>
										<td>필수 필드와 타입</td>
									</tr>
									<tr>
										<td>서버 오류</td>
										<td>분류 가능한 오류 전달</td>
										<td>상태 코드, 재시도 여부</td>
									</tr>
									<tr>
										<td>요청 취소</td>
										<td>작업을 빠르게 종료</td>
										<td>취소 신호가 전달되는지</td>
									</tr>
									<tr>
										<td>잘못된 응답</td>
										<td>검증 오류로 실패</td>
										<td>기본값으로 숨기지 않는지</td>
									</tr>
								</tbody>
							</table>
						</div>
						<h3 id="deterministic-tests">결과를 결정적으로 만드는 방법</h3>
						<p>
							실제 시간을 기다리는 대신 타이머를 제어하고, 네트워크 응답은 테스트 경계에서
							고정합니다. 그러면 간헐적인 지연에 기대지 않고 재시도 횟수와 취소 동작을
							빠르게 확인할 수 있습니다. 각 테스트는 다른 테스트의 실행 순서에 의존하지
							않도록 상태를 정리해야 합니다.
						</p>
					</section>

					<section aria-labelledby="operations">
						<h2 id="operations">운영 환경에서 확인할 것</h2>
						<p>
							운영 로그에는 요청의 시작과 완료, 소요 시간, 실패 분류를 남기되 토큰이나
							개인정보 같은 민감한 값은 기록하지 않습니다. 동일한 요청 흐름을 추적할 수
							있도록 상관관계 ID를 사용하고, 사용자에게 보여주는 메시지와 내부 진단
							정보는 분리합니다.
						</p>
						<ul class="check-list" id="checklist">
							<li>모든 요청에 명확한 시간 제한이 있는가?</li>
							<li>취소 신호가 네트워크 계층까지 전달되는가?</li>
							<li>재시도 횟수와 대상 오류가 제한되어 있는가?</li>
							<li>실패 원인을 민감한 정보 없이 추적할 수 있는가?</li>
						</ul>
						<p>
							좋은 추상화는 실패를 보이지 않게 만들지 않습니다. 오류의 맥락을 보존하면서
							호출자가 합리적인 다음 행동을 선택하도록 돕습니다. 새로운 비동기 함수를
							추가할 때도 이 기준을 작은 계약으로 반복해 보세요.
						</p>
					</section>

					<footer class="article-footer">
						<p>이 문서가 도움이 되었나요?</p>
						<div class="feedback-actions">
							<button type="button" aria-label="이 문서가 도움이 됐어요">도움이 됐어요</button>
							<button type="button" aria-label="이 문서가 아쉬웠어요">더 설명이 필요해요</button>
						</div>
					</footer>
						</>
					)}
				</div>
			</article>
		</main>

		<aside class="toc-sidebar" aria-label="이 페이지 목차">
			<nav class="toc-menu" aria-label="목차">
				<p class="toc-title">이 페이지에서</p>
				{
					isPost ? (
						headings
							.filter((heading) => heading.depth > 1)
							.map((heading) => (
								<a
									class:list={{ 'toc-subitem': heading.depth > 2 }}
									href={`#${heading.slug}`}
								>
									{heading.text}
								</a>
							))
					) : (
						<>
							<a href="#overview">이 글에서 다루는 내용</a>
							<a href="#execution-model">실행 모델 이해하기</a>
							<a class="toc-subitem" href="#event-loop">이벤트 루프와 완료 순서</a>
							<a href="#async-boundaries">안전한 비동기 경계 만들기</a>
							<a class="toc-subitem" href="#validate-response">응답 검증</a>
							<a class="toc-subitem" href="#retry-policy">재시도 정책</a>
							<a href="#testing">실패 경로 테스트</a>
							<a class="toc-subitem" href="#deterministic-tests">결정적 테스트</a>
							<a href="#operations">운영 환경에서 확인할 것</a>
						</>
					)
				}
			</nav>
		</aside>
	</div>

	<script>
		document.querySelectorAll<HTMLTableElement>('.article-body table').forEach((table) => {
			if (table.parentElement?.classList.contains('table-wrap')) return;

			const wrapper = document.createElement('div');
			wrapper.className = 'table-wrap';
			table.before(wrapper);
			wrapper.append(table);
		});

		document.querySelectorAll<HTMLPreElement>('.article-body pre[data-language]').forEach((pre) => {
			if (pre.closest('.code-card')) return;

			const card = document.createElement('div');
			card.className = 'code-card';

			const toolbar = document.createElement('div');
			toolbar.className = 'code-toolbar';

			const language = document.createElement('span');
			language.className = 'language-label';
			const languageNames: Record<string, string> = {
				bash: 'Bash',
				css: 'CSS',
				html: 'HTML',
				js: 'JavaScript',
				json: 'JSON',
				py: 'Python',
				sql: 'SQL',
				ts: 'TypeScript',
			};
			language.textContent =
				languageNames[pre.dataset.language ?? ''] ?? pre.dataset.language ?? 'Text';

			const button = document.createElement('button');
			button.className = 'copy-button';
			button.type = 'button';
			button.textContent = '복사';

			const surface = document.createElement('div');
			surface.className = 'code-surface';

			const status = document.createElement('p');
			status.className = 'sr-only copy-status';
			status.setAttribute('role', 'status');
			status.setAttribute('aria-live', 'polite');

			pre.before(card);
			toolbar.append(language, button);
			surface.append(pre);
			card.append(toolbar, surface, status);

			button.addEventListener('click', async () => {
				const code = pre.innerText;

				try {
					await navigator.clipboard.writeText(code);
					button.textContent = '복사됨';
					status.textContent = '코드가 클립보드에 복사되었습니다.';
				} catch {
					button.textContent = '복사 실패';
					status.textContent = '복사하지 못했습니다. 브라우저의 클립보드 권한을 확인해 주세요.';
				}
			});
		});

		document.querySelectorAll<HTMLButtonElement>('.copy-button[data-copy]').forEach((button) => {
			button.addEventListener('click', () => {
				const code = button.dataset.copy;
				const status = button.closest('.code-card')?.querySelector<HTMLElement>('.copy-status');
				const label = button.querySelector('span');

				if (code === undefined || !status || !label) {
					throw new Error('코드 복사 UI를 초기화할 수 없습니다.');
				}

				navigator.clipboard.writeText(code).then(
					() => {
						label.textContent = '복사됨';
						status.textContent = '코드가 클립보드에 복사되었습니다.';
					},
					() => {
						label.textContent = '복사 실패';
						status.textContent = '복사하지 못했습니다. 브라우저의 클립보드 권한을 확인해 주세요.';
					},
				);
			});
		});
	</script>
	{isPost && <PostFloatingNavigation previous={previous} next={next} />}
</DocumentationLayout>

