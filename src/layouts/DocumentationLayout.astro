---
import Footer from '../components/Footer.astro';
import { categoryNames, categorySlugs, type CategoryName } from '../lib/categories';
import { withBase } from '../lib/urls';

interface Props {
	title: string;
	description: string;
	activeCategory?: CategoryName;
}

const { title, description, activeCategory } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname =
	basePath &&
	(Astro.url.pathname === basePath || Astro.url.pathname.startsWith(`${basePath}/`))
		? Astro.url.pathname.slice(basePath.length) || '/'
		: Astro.url.pathname;
const isHome = pathname === '/';
const hasFloatingNavigation = /^\/posts\/[^/]+\/?$/.test(pathname);
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="application-name" content="통 속의 뇌" />
		<meta property="og:site_name" content="통 속의 뇌" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href={withBase('/')} aria-label="통 속의 뇌 홈">
					<span class="brand-mark" aria-hidden="true">n</span>
					<span>통 속의 뇌</span>
				</a>
				<nav class="top-nav" aria-label="주요 메뉴">
					<a
						class:current={isHome}
						href={withBase('/')}
						aria-current={isHome ? 'page' : undefined}
					>Home</a>
					{
						categoryNames.map((category) => {
							const isCurrent = activeCategory === category;
							return (
								<a
									class:current={isCurrent}
									href={withBase(`/category/${categorySlugs[category]}`)}
									aria-current={isCurrent ? 'page' : undefined}
								>
									{category}
								</a>
							);
						})
					}
				</nav>
			</div>
		</header>
		<div class="site-content">
			<slot />
		</div>
		<Footer hasFloatingNavigation={hasFloatingNavigation} />
	</body>
</html>

<style>
	:global(:root) {
		--home-content-width: min(calc(100% - 48px), 920px);
		--color-accent: #8737ff;
		--color-accent-hover: #6427c7;
		--color-primary-text: #25232a;
		--color-secondary-text: #706d76;
		--color-border: #e9e8ec;
		--color-surface: #f8f8fa;
		--color-subtle-surface: #f3f2f5;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 6rem;
	}

	:global(body) {
		display: flex;
		min-height: 100vh;
		min-height: 100dvh;
		flex-direction: column;
		margin: 0;
		min-width: 320px;
		background: #fff;
		color: var(--color-primary-text);
		font-family:
			Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Apple SD Gothic Neo', 'Noto Sans KR',
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	.site-content {
		flex: 1 0 auto;
	}

	.skip-link {
		position: fixed;
		z-index: 20;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.65rem 0.9rem;
		transform: translateY(-160%);
		border-radius: 0.4rem;
		background: var(--color-primary-text);
		color: #fff;
		font-size: 0.875rem;
		text-decoration: none;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.site-header {
		position: sticky;
		z-index: 10;
		top: 0;
		height: 64px;
		border-bottom: 1px solid var(--color-border);
		background: rgb(255 255 255 / 94%);
		backdrop-filter: blur(12px);
	}

	.header-inner {
		display: flex;
		width: min(100% - 64px, 1480px);
		height: 100%;
		align-items: center;
		margin: 0 auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--color-primary-text);
		font-size: 0.95rem;
		font-weight: 650;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 27px;
		height: 27px;
		place-items: center;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		color: var(--color-secondary-text);
		font-family: Georgia, serif;
		font-size: 1.15rem;
		font-style: italic;
	}

	.top-nav {
		display: flex;
		height: 100%;
		align-items: center;
		gap: 1.7rem;
		margin-left: 3rem;
	}

	.top-nav a,
	.top-nav a:visited {
		display: inline-flex;
		height: 100%;
		align-items: center;
		color: var(--color-secondary-text);
		font-size: 0.84rem;
		text-decoration: none;
	}

	.top-nav a:hover {
		color: var(--color-accent-hover);
	}

	.top-nav .current {
		border-bottom: 2px solid var(--color-accent);
		color: var(--color-primary-text);
		font-weight: 600;
	}

	.top-nav .current:visited {
		color: var(--color-primary-text);
	}

	.top-nav a:focus-visible {
		border-radius: 0.25rem;
		outline: 2px solid var(--color-accent);
		outline-offset: -3px;
	}

	@media (max-width: 640px) {
		.site-header {
			height: 58px;
		}

		.header-inner {
			width: calc(100% - 36px);
			gap: 0.75rem;
		}

		.brand {
			flex: none;
		}

		.top-nav {
			min-width: 0;
			flex: 1 1 0;
			gap: 0.25rem;
			margin-left: 0;
			overflow-x: auto;
			overscroll-behavior-x: contain;
		}

		.top-nav a {
			flex: none;
			padding: 0 0.45rem;
			font-size: 0.78rem;
		}
	}

	@media (max-width: 600px) {
		:global(:root) {
			--home-content-width: calc(100% - 36px);
		}
	}
</style>
